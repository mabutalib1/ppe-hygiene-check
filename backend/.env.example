# ---- camera ----
# RTSP/HTTP URL (CCTV or phone IP-camera app), webcam index (0), video file path, "synthetic",
# or "nebras" = the shop's live camera through the Nebras camera API (settings below)
CAMERA_SOURCE=0
CAMERA_NAME=kitchen-1
LOOP_VIDEO=true

# ---- Nebras live camera (CAMERA_SOURCE=nebras); never commit real values ----
NEBRAS_API_URL=https://api.nebrasinsights.com   # http://localhost:3001 when Nebras runs locally
NEBRAS_BRAND_ID=905ccc5c-eda7-487c-8cf6-c89a1db141b4   # Candira in production
NEBRAS_CHANNEL_ID=             # list them: python -m app.nebras cameras
NEBRAS_QUALITY=hd              # hd or fluent
NEBRAS_EMAIL=                  # admin account with camera access
NEBRAS_PASSWORD=
NEBRAS_TOKEN=                  # optional: a ready JWT instead of email/password (expires)
NEBRAS_COMPANY_SLUG=           # only for a super-admin acting in a tenant (e.g. mrg)

# ---- model ----
# "yolo" = real model, "fake" = scripted detections (build the app before the model exists)
DETECTOR=yolo
WEIGHTS=weights/best.pt        # or weights/best.onnx for faster CPU inference
# If WEIGHTS has no "person" class, people are found and tracked by this stock
# COCO model (downloaded automatically on first run) and WEIGHTS only finds items.
PERSON_WEIGHTS=yolo26n.pt
DEVICE=                        # empty = auto, cpu, or 0 for the first GPU
IMGSZ=640
TARGET_FPS=10

# ---- storage ----
DATA_DIR=runtime               # events.db + snapshots/

# ---- dashboard ----
# PROJECT_DIR=..                 # repo root: where training/, evaluation/, data/ results are read
# DASHBOARD_DIR=../dashboard/dist

# ---- violation logic (starting values; tune on the event clips) ----
CHECK_ITEM_CONF=0.40
CHECK_WINDOW_S=3.0
CHECK_VIOLATION_RATIO=0.70
CHECK_MIN_VISIBILITY=0.40
CHECK_DECIDE_AFTER_S=3.0
CHECK_COOLDOWN_S=30
CHECK_REENTRY_S=10
CHECK_REENTRY_DIST=0.15

# ---- training only (never commit the real key) ----
ROBOFLOW_API_KEY=
