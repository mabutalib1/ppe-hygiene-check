# ---- camera ----
# RTSP/HTTP URL (CCTV or phone IP-camera app), webcam index (0), video file path, or "synthetic"
CAMERA_SOURCE=0
CAMERA_NAME=kitchen-1
LOOP_VIDEO=true

# ---- model ----
# "yolo" = real model, "fake" = scripted detections (build the app before the model exists)
DETECTOR=yolo
WEIGHTS=weights/best.pt        # or weights/best.onnx for faster CPU inference
DEVICE=                        # empty = auto, cpu, or 0 for the first GPU
IMGSZ=640
TARGET_FPS=10

# ---- storage ----
DATA_DIR=runtime               # events.db + snapshots/

# ---- violation logic (starting values; tune on the event clips) ----
CHECK_ITEM_CONF=0.40
CHECK_WINDOW_S=3.0
CHECK_VIOLATION_RATIO=0.70
CHECK_MIN_VISIBILITY=0.40
CHECK_DECIDE_AFTER_S=3.0
CHECK_COOLDOWN_S=30
CHECK_REENTRY_S=10
CHECK_REENTRY_DIST=0.15

# ---- training only (never commit the real key) ----
ROBOFLOW_API_KEY=
